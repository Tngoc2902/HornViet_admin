# Địa chỉ backend Hồn Sừng Việt (HornViet.Api).
# Dev: backend phải có http://localhost:3001 trong App:CorsOrigins.
# Production: đổi thành domain API thật, và thêm domain trang quản trị vào App:CorsOrigins của backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:21021
# NEXT_PUBLIC_API_BASE_URL=https://localhost:44311
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com

# Địa chỉ trang cửa hàng (nút "Xem cửa hàng" / "Về cửa hàng").
# Production: đổi thành domain cửa hàng thật. Nếu để trống, các nút/link này sẽ tự ẩn thay vì trỏ về localhost.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
# NEXT_PUBLIC_STORE_URL=https://your-domain.com
